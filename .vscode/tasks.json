{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build jvm-poc-sdl-demo",
            "type": "shell",
            "command": "make -C tools/jvm-poc clean && make -C tools/jvm-poc jvm-poc-sdl-demo",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
