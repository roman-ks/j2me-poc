{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
    {
        "name": "SDL Demo (gdb)",
        "type": "cppdbg",
        "request": "launch",
        "program": "${workspaceFolder}/tools/jvm-poc/build/jvm-poc-sdl-demo",
        "args": ["${input:midletRoot}"],
        "stopAtEntry": false,
        "cwd": "${workspaceFolder}",
        "environment": [],
        "externalConsole": false,
        "MIMode": "gdb",
        "preLaunchTask": "build jvm-poc-sdl-demo",
        "setupCommands": [
            {
                "description": "Enable pretty-printing for gdb",
                "text": "-enable-pretty-printing",
                "ignoreFailures": true
            },
            {
                "description": "Set Disassembly Flavor to Intel",
                "text": "-gdb-set disassembly-flavor intel",
                "ignoreFailures": true
            }
        ]
    },
    ],
    "inputs": [
        {
            "id": "midletRoot",
            "type": "promptString",
            "description": "Path to the extracted MIDlet root directory",
            "default": "${userHome}/Downloads/game"
        }
    ]
}